rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Chaque utilisateur connecté n'accède qu'à son propre espace.
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // Tout le reste (ancien journal, collection accounts globale, etc.) est fermé.
  }
}
